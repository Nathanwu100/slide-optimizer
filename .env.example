# Optional. Without this key the app remains fully functional in local analysis-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Recommended in production, for example https://slide-optimizer-ten.vercel.app
ALLOWED_ORIGIN=

# Optional private usage tracker. Vercel/Upstash may supply the Redis values automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Choose a long random value. Enter it at /usage to view private aggregate counts.
USAGE_ADMIN_TOKEN=
